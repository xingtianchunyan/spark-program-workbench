# Copy this file to .env on the computer that runs Spark Program Workbench.
# Never upload, share, or commit the real .env file.
SPARK_KIMI_API_KEY=
SPARK_AI_API_KEY=

# WebBridge is disabled by default. Enable it only when the local daemon is
# configured to validate the same long random token on every request.
SPARK_ENABLE_WEBBRIDGE=0
SPARK_WEBBRIDGE_TOKEN=

# Browser workbench. The server always binds to 127.0.0.1.
SPARK_WEB_PORT=8765
SPARK_TEAM_MODE=0
SPARK_SESSION_SECRET=
SPARK_CSRF_SECRET=

# Unattended Notion automation uses the official REST API because hosted
# Notion MCP currently requires interactive OAuth. Create a Notion personal
# access token with Notion API permission, then grant it access to the copied
# Dashboard page. Do not use the separate workspace-connection token, OAuth
# Client Secret, or a token copied from a page URL. Keep it only in real .env.
NOTION_TOKEN=
SPARK_NOTION_AUTO_EXECUTE=1

# Optional AI extraction settings. Existing SPARK_AI_API_KEY or
# SPARK_KIMI_API_KEY is reused; model names can be overridden here.
SPARK_AI_MODEL=deepseek-ai/DeepSeek-V3
SPARK_KIMI_MODEL=moonshot-v1-8k

# Team-mode Nervos Talk posting uses each member's own Discourse User API key.
# Replace USERNAME with the upper-case username and non-alphanumerics as _.
# Example: SPARK_DISCOURSE_USER_API_KEY_XINGTIANCHUNYAN=
